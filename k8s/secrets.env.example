# copiar para k8s/secrets.env e rodar ./scripts/gen-secrets.sh
# senha com caractere especial precisa ir url-encoded

# rds
AUTH_DATABASE_URL=postgres://postgres:SENHA@auth-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/auth_db?sslmode=require
FLAG_DATABASE_URL=postgres://postgres:SENHA@flag-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/flags_db?sslmode=require
TARGETING_DATABASE_URL=postgres://postgres:SENHA@targeting-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/targeting_db?sslmode=require

# auth
MASTER_KEY=troque-esta-master-key
# o job de init grava o hash dessa chave no banco
SERVICE_API_KEY=tm_key_troque_esta_chave_de_servico

# elasticache (rediss:// se tiver tls)
REDIS_URL=redis://togglemaster-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379

# sqs e dynamodb
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/togglemaster-events
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# opcional, vazio usa a role do nó
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
